    "Local.0004": {
      "id": "Local.0004",
      "description": "Logging to local or network paths detected.\n\nIf you are targeting Managed Instance on Azure App Service, prefer Application Insights/App Service logging. If filesystem logs are required, write to a mounted Azure Files share configured via storage mounts and Key Vault secrets.\n\nLogging APIs that write to disk might not work on Azure App Service or Container.\n\nUse logging that stores logs in locations outside of the host unless its specifically required by your app. You can also use logging capabilities embedded in Azure, such as Azure App Service logging or Application Insights.\n\nFor migrating to AKS, use LogMonitor tool that can capture logs written to files, the console, or write logs and redirect them to Azure.",
      "title": "\u68C0\u6D4B\u5230\u8BB0\u5F55\u5230\u672C\u5730\u8DEF\u5F84\u6216\u7F51\u7EDC\u8DEF\u5F84",
      "severity": "mandatory",
      "effort": 3,
      "links": [
        {
          "title": "[Managed Instance] Storage mounts",
          "url": "https://go.microsoft.com/fwlink/?linkid=2346952"
        },
        {
          "title": "Logging in Azure App Service",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2251711"
        },
        {
          "title": "Logging in Application Insights",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2251712"
        },
        {
          "title": "LogMonitor",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2251308"
        }
      ],
      "labels": []
    },
    "Connection.0001": {
      "id": "Connection.0001",
      "description": "\u68C0\u6D4B\u5230\u8FDE\u63A5\u5B57\u7B26\u4E32\u3002\u5F53\u5E94\u7528\u8FC1\u79FB\u5230 Azure \u65F6\uFF0C\u5B83\u53EF\u80FD\u4E0D\u53EF\u7528\u3002\n\n\u67E5\u770B\u5E76\u786E\u4FDD\u5B83\u5728 Azure \u4E2D\u6B63\u5E38\u5DE5\u4F5C\u3002\u5982\u679C\u8981\u8FDE\u63A5\u5230\u6570\u636E\u5E93\uFF0C\u53EF\u80FD\u9700\u8981\u5C06\u6570\u636E\u5E93\u8FC1\u79FB\u5230 Azure\u3002\u53EF\u901A\u8FC7\u591A\u79CD\u65B9\u6CD5\u6765\u5B9E\u73B0\u8FD9\u4E00\u70B9:\n   1. \u8FC1\u79FB\u5230 Azure SQL \u6570\u636E\u5E93\u4EE5\u83B7\u5F97\u5176\u4ED6\u6743\u76CA(\u8BF7\u53C2\u9605\u4E0B\u9762\u7684\u94FE\u63A5)\u3002\n   2. \u5982\u679C\u9700\u8981 Azure SQL \u6570\u636E\u5E93\u4E2D\u4E0D\u53EF\u7528\u7684\u529F\u80FD\uFF0C\u4E14\u4F60\u4E0D\u60F3\u4F7F\u7528 VM\uFF0C\u8BF7\u8003\u8651\u4F7F\u7528 Azure SQL \u6258\u7BA1\u5B9E\u4F8B\u3002\n   3. \u5C06\u6570\u636E\u5E93\u670D\u52A1\u5668\u76F4\u63A5\u8FC1\u79FB\u5230 Azure VM \u4E0A\u7684 SQL Server\u3002\n\n\u82E5\u8981\u8BC4\u4F30\u6570\u636E\u5E93\u8FC1\u79FB\u5DE5\u4F5C\uFF0C\u53EF\u4F7F\u7528 Azure Migrate \u5DE5\u5177\u3002\u8BF7\u53C2\u9605\u4E0B\u9762\u7684\u94FE\u63A5\u3002",
      "title": "\u68C0\u6D4B\u5230\u8FDE\u63A5\u5B57\u7B26\u4E32",
      "severity": "potential",
      "effort": 3,

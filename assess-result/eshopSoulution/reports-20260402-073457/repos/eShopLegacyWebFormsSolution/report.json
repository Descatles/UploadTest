  "rules": {
    "Scale.0001": {
      "id": "Scale.0001",
      "description": "\u68C0\u6D4B\u5230\u9759\u6001\u5185\u5BB9\u3002\n\n\u5F53\u524D\u76F4\u63A5\u5904\u7406\u9759\u6001\u5185\u5BB9\u7684\u65B9\u6CD5\u53EF\u80FD\u4F1A\u5BFC\u81F4\u6210\u672C\u589E\u52A0\u3001\u6027\u80FD\u95EE\u9898\u3001\u7EF4\u62A4\u96BE\u9898(\u9700\u8981\u91CD\u65B0\u90E8\u7F72\u5E94\u7528\u7A0B\u5E8F\u4EE5\u8FDB\u884C\u5185\u5BB9\u66F4\u6539)\u548C\u5B89\u5168\u98CE\u9669\u3002\n\n\u8BF7\u8003\u8651\u5C06\u9759\u6001\u5185\u5BB9\u79FB\u52A8\u5230 Azure Blob \u5B58\u50A8\u5E76\u6DFB\u52A0 Azure CDN\u3002",
      "title": "\u68C0\u6D4B\u5230\u9759\u6001\u5185\u5BB9",
      "severity": "optional",
      "effort": 3,
      "links": [

    "Identity.0002": {
      "id": "Identity.0002",
      "description": "\u4F60\u7684\u5E94\u7528\u4F7F\u7528\u7684\u662F Windows \u8EAB\u4EFD\u9A8C\u8BC1\uFF0C\u800C Azure \u5E94\u7528\u670D\u52A1\u3001Azure \u5BB9\u5668\u5E94\u7528\u548C Azure Kubernetes \u670D\u52A1\u4E0D\u652F\u6301\u8BE5\u8EAB\u4EFD\u9A8C\u8BC1\u3002\n\nAzure \u5E94\u7528\u670D\u52A1\u63D0\u4F9B\u5185\u7F6E\u8EAB\u4EFD\u9A8C\u8BC1\u548C\u6388\u6743\u529F\u80FD\uFF0C\u56E0\u6B64\u4F60\u53EF\u901A\u8FC7\u5728 Web \u5E94\u7528\u4E2D\u7F16\u5199\u6700\u5C11\u4EE3\u7801\u6216\u4E0D\u7F16\u5199\u4EE3\u7801\u6765\u767B\u5F55\u7528\u6237\u548C\u8BBF\u95EE\u6570\u636E\u3002\n\n\u6709\u5173\u8BE6\u7EC6\u4FE1\u606F\uFF0C\u8BF7\u8BBF\u95EE\u4E0B\u9762\u7684\u94FE\u63A5\u3002\u201D",
